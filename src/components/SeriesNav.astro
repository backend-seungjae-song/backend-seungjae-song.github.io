---
import { getCollection } from 'astro:content';
interface Props { current?: number; }
const { current } = Astro.props;
const posts = (await getCollection('blog')).filter(post => post.data.seriesOrder !== undefined).sort((a, b) => a.data.seriesOrder! - b.data.seriesOrder!);
---
<nav aria-label="LLM 엔지니어링 시리즈" class="series-nav"><p>이 시리즈</p><ol>{posts.map(post => <li><a href={`/blog/${post.id}/`} aria-current={current === post.data.seriesOrder ? 'page' : undefined}><span>{post.data.seriesOrder}화</span><span>{post.data.seriesLabel?.split(' · ')[0]}</span></a></li>)}</ol></nav>
<style>
  p { font-size: 12px; color: var(--muted); margin: 0 0 12px; }
  ol { list-style: none; margin: 0; padding: 0; }
  a { display: flex; gap: 14px; padding: 10px 12px; margin-left: -12px; min-height: 44px; text-decoration: none; font-size: 13px; color: var(--muted); border-radius: 4px; }
  a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); font-weight: 650; }
  a:hover { color: var(--accent); }
</style>

---
import { getCollection } from 'astro:content';

interface Props {
	current?: number;
}

const { current } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => post.data.seriesOrder !== undefined)
	.sort((a, b) => a.data.seriesOrder! - b.data.seriesOrder!);
---

<nav aria-label="LLM 엔지니어링 시리즈" class="series-nav">
	<p>빈칸으로 이해하는 LLM 엔지니어링</p>
	<ol>
		{posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`} aria-current={current === post.data.seriesOrder ? 'page' : undefined}>
					<span class="number">{post.data.seriesOrder}</span>
					<span>{post.data.seriesLabel}</span>
				</a>
			</li>
		))}
	</ol>
</nav>

<style>
	.series-nav { margin: 1.25rem 0 2rem; padding: 0.75rem 0; border-block: 1px solid rgb(var(--gray-light)); }
	.series-nav p { margin: 0 0 0.75rem; font-size: 0.85rem; color: rgb(var(--gray-dark)); }
	ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 1rem; }
	a { display: flex; align-items: baseline; gap: 0.65rem; padding: 0.3rem 0; text-decoration: none; font-size: 0.9rem; }
	a:hover { text-decoration: underline; }
	a[aria-current="page"] { color: rgb(var(--black)); font-weight: 700; }
	.number { font-variant-numeric: tabular-nums; color: rgb(var(--gray)); }
	@media (max-width: 540px) { ol { grid-template-columns: 1fr; } }
</style>

---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <p>© {year} 송승재</p>
  <div class="footer-links"><a href="https://github.com/backend-seungjae-song">GitHub</a><a href="/rss.xml">RSS</a></div>
  <div class="preferences" hidden><button id="theme-toggle" type="button">어두운 화면</button><button id="motion-toggle" type="button" aria-pressed="true">모션 켜짐</button></div>
</footer>
<script>
  const root = document.documentElement;
  const theme = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const motion = document.querySelector<HTMLButtonElement>('#motion-toggle');
  function updateLabels() {
    const dark = root.dataset.theme === 'dark';
    const moving = root.dataset.motion !== 'off';
    if (theme) { theme.textContent = dark ? '밝은 화면' : '어두운 화면'; }
    if (motion) { motion.textContent = moving ? '모션 켜짐' : '모션 꺼짐'; motion.setAttribute('aria-pressed', String(moving)); }
  }
  function save(key: string, value: string) { try { localStorage.setItem(key, value); } catch {} }
  theme?.addEventListener('click', () => { root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark'; save('site-theme', root.dataset.theme); updateLabels(); });
  motion?.addEventListener('click', () => { root.dataset.motion = root.dataset.motion === 'off' ? 'on' : 'off'; save('site-motion', root.dataset.motion); updateLabels(); });
  updateLabels();
  const preferences = document.querySelector<HTMLElement>('.preferences');
  if (preferences) preferences.hidden = false;
</script>
<style>
  .site-footer { width: min(var(--page-width), calc(100% - 96px)); margin: auto; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 32px; padding: 24px 0 36px; color: var(--muted); font-size: 12px; }
  .preferences[hidden] { display: none; }
  p { margin: 0; } .footer-links, .preferences { display: flex; align-items: center; gap: 20px; } .preferences { margin-left: auto; gap: 16px; }
  a { text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  button { background: none; color: inherit; border: none; padding: 0; min-height: 44px; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  @media(max-width:767px) { .site-footer { width: calc(100% - 40px); flex-wrap: wrap; gap: 0 24px; } .preferences { width: 100%; margin: 0; } }
</style>
